# ============================================================
# Production environment for docker-compose.hosting.yaml
# Copy to ./stack.env and fill in real values:
#   cp stack.env.dist stack.env && chmod 600 stack.env
# stack.env is git-ignored — never commit real secrets.
# ============================================================

# --- Symfony -------------------------------------------------
APP_ENV=prod
# Generate a unique random value, e.g. `openssl rand -hex 32`.
APP_SECRET=

# Absolute URL used to generate links in CLI/webhook contexts.
DEFAULT_URI=https://your-domain.example

# --- Tron / payments -----------------------------------------
# Donation destination address.
APP_DONATE=
# Watch-only master public key (xpub). Safe to store on the server.
TRON_XPUB_MASTER_KEY=
TRON_NETWORK=mainnet
# https://www.trongrid.io/dashboard
TRON_API_KEY=
PAYMENT_WINDOW=1 hour
PAYMENT_BATCH_SIZE=50

# --- Executor cabinet ----------------------------------------
UPLOAD_DIR=var/uploads
TASK_EXECUTION_DEADLINE_SECONDS=7200

# --- MCP endpoint kill switch ---------------------------------
MCP_ENABLED=1

# --- Escrow payouts (docs/payouts-redesign.md) ----------------
# Online server: PAYOUT_ENABLED=1 builds intents. TRON_MNEMONIC and
# TRON_PASSPHRASE must stay EMPTY here — they belong only on the
# offline settlement machine (app:payout:settle).
PAYOUT_ENABLED=1
PAYOUT_TTL=30 minutes
PAYOUT_FEE_MARGIN=20
PAYOUT_DIR=var/payout
PAYOUT_BATCH_SIZE=200
TRON_MNEMONIC=
TRON_PASSPHRASE=

# --- Database (must match POSTGRES_* below) -------------------
# Server version must stay in sync with the postgis image tag.
DATABASE_URL=postgresql://app:CHANGE_ME@database:5432/app?serverVersion=18&charset=utf8
POSTGRES_DB=app
POSTGRES_USER=app
# Strong password — not the dev default "secret".
POSTGRES_PASSWORD=CHANGE_ME

# --- Messenger ------------------------------------------------
# auto_setup=0: the messenger_messages table is created by migrations.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# --- Mailer ---------------------------------------------------
# null://null disables mail. A real production app needs a real DSN:
#   MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null

# --- CORS (Nelmio) --------------------------------------------
# Regex for the real frontend origin(s), e.g.:
#   CORS_ALLOW_ORIGIN='^https://(app|www)\.your-domain\.example$'
CORS_ALLOW_ORIGIN='^https:\/\/.*\.your-domain\.example$'

# --- Lock (symfony/lock) --------------------------------------
# Single instance: flock is fine. If you scale php-fpm horizontally
# use a shared store: postgresql+advisory://app:CHANGE_ME@database:5432/app
LOCK_DSN=flock