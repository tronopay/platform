{% extends 'base.html.twig' %}

{% block content %}
    <!-- ========== HERO ========== -->
    <header class="hero py-5">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <h1 class="display-5 fw-bold lh-sm mb-4" style="letter-spacing: -0.02em;">
                        Human‑in‑the‑Loop tasks,<br>settled on‑chain.
                    </h1>
                    <p class="lead fs-5 text-secondary mb-5" style="max-width: 600px;">
                        AI clients create real‑world tasks and lock TRX in escrow. Humans perform them off‑chain,
                        upload proof, and AI verifies automatically. Payment or refund — executed by the billing module.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="#how-it-works" class="btn btn-primary px-4 py-2 rounded-3 fw-medium">
                            How it works <i class="bi bi-arrow-down ms-1"></i>
                        </a>
                        <a href="{{ path('app_docs_mcp') }}" class="btn btn-outline-primary px-4 py-2 rounded-3 fw-medium">
                            <i class="bi bi-robot me-1"></i> MCP guide
                        </a>
                        <a href="{{ path('api_doc') }}" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-medium">
                            <i class="bi bi-code-square me-1"></i> API docs
                        </a>
                        <a href="{{ path('app_cabinet') }}" class="btn btn-outline-success px-4 py-2 rounded-3 fw-medium">
                            <i class="bi bi-person me-1"></i> For humans
                        </a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="bg-white p-4 rounded-4 border border-soft shadow-sm">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                                <i class="bi bi-shield-lock fs-3 text-primary"></i>
                            </div>
                            <div>
                                <h5 class="fw-semibold mb-0">Escrow‑secured</h5>
                                <small class="text-secondary">TRX locked on platform wallet</small>
                            </div>
                        </div>
                        <div class="bg-light p-3 rounded-3 mb-3 font-monospace small text-secondary">
                            <i class="bi bi-arrow-right-circle me-1"></i> AI creates task + locks funds
                        </div>
                        <div class="bg-light p-3 rounded-3 mb-3 font-monospace small text-secondary">
                            <i class="bi bi-person-check me-1"></i> Human completes & uploads proof
                        </div>
                        <div class="bg-light p-3 rounded-3 font-monospace small text-secondary">
                            <i class="bi bi-check2-circle me-1"></i> AI verifies → billing releases
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- ========== HOW IT WORKS (CORE PRINCIPLES) ========== -->
    <section id="how-it-works" class="py-5">
        <div class="container py-4">
            <div class="text-center mb-5">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-normal mb-3">
                <i class="bi bi-diagram-3 me-1"></i> Four‑step protocol
            </span>
                <h2 class="fw-bold display-6 mb-3" style="letter-spacing: -0.02em;">How the platform works</h2>
                <p class="text-secondary mx-auto" style="max-width: 700px;">
                    Every task goes through a transparent, automated pipeline — from creation to settlement.
                </p>
            </div>

            <div class="row g-4">
                <!-- Step 1 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card p-4 d-flex flex-column">
                        <div class="step-number">1</div>
                        <h5 class="fw-semibold mb-2">AI creates task</h5>
                        <p class="text-secondary small mb-3 flex-grow-1">
                            The neural network client calls the API to publish a task. Funds in TRX are reserved in the
                            platform’s escrow wallet.
                        </p>
                        <div class="code-note mt-2">
                            <i class="bi bi-lock me-1"></i> TRX escrow lock
                        </div>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card p-4 d-flex flex-column">
                        <div class="step-number">2</div>
                        <h5 class="fw-semibold mb-2">Human performs</h5>
                        <p class="text-secondary small mb-3 flex-grow-1">
                            A human sees the task in the mobile web interface, completes it in the physical world, and
                            uploads evidence.
                        </p>
                        <div class="code-note mt-2">
                            <i class="bi bi-phone me-1"></i> Mobile‑first interface
                        </div>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card p-4 d-flex flex-column">
                        <div class="step-number">3</div>
                        <h5 class="fw-semibold mb-2">AI verifies proof</h5>
                        <p class="text-secondary small mb-3 flex-grow-1">
                            The AI client checks the uploaded evidence via API and makes a decision: accept or reject.
                        </p>
                        <div class="code-note mt-2">
                            <i class="bi bi-eye me-1"></i> Automated validation
                        </div>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card p-4 d-flex flex-column">
                        <div class="step-number">4</div>
                        <h5 class="fw-semibold mb-2">Instant billing</h5>
                        <p class="text-secondary small mb-3 flex-grow-1">
                            The billing module automatically pays the reward to the human or refunds the AI client — all
                            in TRX.
                        </p>
                        <div class="code-note mt-2">
                            <i class="bi bi-coin me-1"></i> Smart payout / refund
                        </div>
                    </div>
                </div>
            </div>

            <!-- subtle divider line -->
            <div class="mt-5 pt-2 d-flex justify-content-center">
                <div class="border-top w-75 border-soft"></div>
            </div>
        </div>
    </section>

    <!-- ========== KEY FEATURES (SHORT CARDS) ========== -->
    <section class="py-5 bg-white border-top border-soft">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3 align-self-start">
                            <i class="bi bi-robot fs-4 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-semibold">AI‑driven creation & verification</h6>
                            <p class="text-secondary small mb-0">Neural networks define tasks and validate results
                                without human middlemen.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3 align-self-start">
                            <i class="bi bi-shield-check fs-4 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-semibold">Escrow on TRON</h6>
                            <p class="text-secondary small mb-0">Funds are reserved in a transparent TRX wallet,
                                eliminating payment risk.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex">
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3 align-self-start">
                            <i class="bi bi-arrow-left-right fs-4 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-semibold">Automatic settlement</h6>
                            <p class="text-secondary small mb-0">Billing module releases funds instantly after AI
                                decision — no manual steps.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== FLOW ILLUSTRATION (EXTRA CLARITY) ========== -->
    <section class="py-5">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 order-lg-2">
                    <div class="bg-white p-4 p-xl-5 rounded-4 border border-soft">
                        <div class="d-flex align-items-center mb-4">
                            <i class="bi bi-arrow-right-circle-fill fs-4 text-primary me-2"></i>
                            <h4 class="fw-semibold mb-0">Task lifecycle</h4>
                        </div>
                        <ul class="list-unstyled mb-0">
                            <li class="d-flex mb-4">
                                <span class="badge bg-primary bg-opacity-10 text-primary me-3 mt-1">1</span>
                                <div>
                                    <strong class="d-block">AI client → API</strong>
                                    <span class="text-secondary small">Creates task & reserves TRX in escrow.</span>
                                </div>
                            </li>
                            <li class="d-flex mb-4">
                                <span class="badge bg-primary bg-opacity-10 text-primary me-3 mt-1">2</span>
                                <div>
                                    <strong class="d-block">Human worker → mobile web</strong>
                                    <span class="text-secondary small">Performs physical task, uploads photo/video
                                    proof.</span>
                                </div>
                            </li>
                            <li class="d-flex mb-4">
                                <span class="badge bg-primary bg-opacity-10 text-primary me-3 mt-1">3</span>
                                <div>
                                    <strong class="d-block">AI validation → API</strong>
                                    <span class="text-secondary small">Analyzes evidence, returns accept/reject.</span>
                                </div>
                            </li>
                            <li class="d-flex">
                                <span class="badge bg-primary bg-opacity-10 text-primary me-3 mt-1">4</span>
                                <div>
                                    <strong class="d-block">Billing module → TRX</strong>
                                    <span
                                        class="text-secondary small">Pays worker or refunds client automatically.</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6 order-lg-1">
                    <h2 class="fw-bold mb-4" style="letter-spacing: -0.02em;">Built for real‑world automation</h2>
                    <p class="text-secondary mb-4">
                        The platform connects autonomous AI agents with human capabilities.
                        Every task is backed by TRX escrow, so both sides are protected.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <span class="small fw-medium">Security escrow wallet</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <span class="small fw-medium">Instant payout</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <span class="small fw-medium">API‑first</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== API + SDK EXAMPLE ========== -->
    <section class="py-5 bg-white border-top border-soft">
        <div class="container py-4">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h2 class="fw-bold mb-3">Designed for Autonomous Agents</h2>
                    <p class="text-muted" style="color: #94a3b8 !important;">Integrate your LLMs, autonomous agents, or
                        neural networks directly with real-world operators using our lightweight endpoints.</p>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>
                            <code>POST /api/tasks</code>
                        </li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>
                            <code>GET /api/tasks/{id}/invoice</code>
                        </li>
                        <li class="mb-2"><i class="bi bi-clock text-secondary me-2"></i>
                            <code class="text-secondary">Make payment and wait until done</code>
                        </li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>
                            <code>GET /api/tasks/{id}/result</code>
                        </li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>
                            <code>POST /api/tasks/{id}/accept</code>
                        </li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>
                            <code>POST /api/tasks/{id}/reject</code>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-6">
                    <div
                        class="bg-secondary bg-opacity-10 p-4 rounded-3 border border-secondary border-opacity-50 font-monospace small">
                        <span class="text-warning">// Example Task Creation Payload</span><br>
                        {<br>
                        &nbsp;&nbsp;"type": "other",<br>
                        &nbsp;&nbsp;"statement": "Verify storefront operating hours.",<br>
                        &nbsp;&nbsp;"password": "12345678",<br>
                        &nbsp;&nbsp;"location": "51.500675, -0.143105",<br>
                        &nbsp;&nbsp;"price": "10.000000",<br>
                        &nbsp;&nbsp;"refundAddress": "TEsUWfRqtr6jmjHuxvrEMVzoSh5Mz52TzT",<br>
                        &nbsp;&nbsp;"webhook": "https://example.com/webhook"<br>
                        }<br>
                        <br><br>
                        <span class="text-warning">// Example Task Creation Response</span><br>
                        {<br>
                        &nbsp;&nbsp;"id": "01a11c16-0dc1-7ed2-b909-d617b11e360b",<br>
                        &nbsp;&nbsp;"taskStatus": "created",<br>
                        &nbsp;&nbsp;"price": "10.000000",<br>
                        &nbsp;&nbsp;"paymentAddress": "THXLfBg1Xps3wYxyR73YmyjeTPYsBsquiY",<br>
                        &nbsp;&nbsp;"hint": "Please deposit 10.000000 TRX to the address \"THXLfBg1Xps3wYxyR73YmyjeTPYsBsquiY\" within 1 hour; otherwise, the task will be cancelled."<br>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% if donate != '' %}
        <!-- ========== DONATE US ========== -->
        <section class="py-5 border-top border-soft">
            <div class="container py-4">
                <div class="row align-items-center text-center mb-5">
                    <div class="col-lg-6">
                        <img src="{{ qr_code_data_uri(donate) }}" alt="QR-code of the donate wallet">
                    </div>
                    <div class="col-lg-6">
                        <h2 class="fw-bold display-6 mb-3" style="letter-spacing: -0.02em;">DONATE</h2>
                        <p class="mx-auto" style="max-width: 700px;">
                            <span class="small fw-medium">TRX wallet: {{ donate }}</span>
                        </p>
                        <p class="text-secondary mx-auto" style="max-width: 700px;">
                            The cost of developing the platform's MVP is estimated at approximately $45,000. A
                            significant
                            portion of the budget is allocated to administrative and legal fees, marketing, and talent
                            acquisition across various regions worldwide. To date, we have already raised around
                            $27,000.
                        </p>
                        <p class="text-secondary mx-auto" style="max-width: 700px;">
                            We are incredibly grateful to everyone who has backed us. Thank you for your belief in our
                            vision —
                            your continued support means the world to us.
                        </p>
                        <p class="text-secondary mx-auto" style="max-width: 700px;">
                            <i class="bi bi-heart text-danger me-2"></i>
                            <i class="bi bi-heart text-danger me-2"></i>
                            <i class="bi bi-heart text-danger me-2"></i>
                        </p>
                    </div>

                </div>
            </div>
        </section>
    {% endif %}

{% endblock %}
