{% extends 'cabinet_layout.html.twig' %}

{% block cabinet_content %}
    <div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary">{{ task.type.value|upper }}</span>
            <span class="badge bg-info bg-opacity-10 text-info">{{ task.status.value }}</span>
        </div>
        <span class="fw-semibold text-success"><i class="bi bi-coin me-1"></i>{{ (task.priceSun / 1000000)|number_format(6) }} TRX</span>
    </div>

    <h1 class="h5 fw-bold">Task statement</h1>
    <p class="text-secondary">{{ task.statement }}</p>

    {% if task.status.value == 'assigned' and task.executionDeadlineAt %}
        {# Single source for the danger threshold, shared by the server render and the countdown. #}
        {% set urgencyThreshold = 900 %}
        <div class="alert {{ deadlineRemaining is not null and deadlineRemaining < urgencyThreshold ? 'alert-danger' : 'alert-warning' }} py-2 d-flex justify-content-between align-items-center"
             role="timer"
             aria-live="off"
             data-controller="countdown"
             data-countdown-deadline-value="{{ task.executionDeadlineAt|date('c') }}"
             data-countdown-now-value="{{ 'now'|date('c') }}"
             data-countdown-urgency-threshold-value="{{ urgencyThreshold }}">
            <span class="small"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i> Time left</span>
            {# Server-rendered fallback so the deadline is visible without JavaScript. #}
            <span class="fw-bold font-monospace" data-countdown-target="value">{{ deadlineRemainingText }}</span>
            <span class="visually-hidden">Deadline {{ task.executionDeadlineAt|date('d.m.Y H:i T') }}</span>
        </div>
    {% endif %}

    {% if task.status.value == 'assigned' %}
        <div class="card border-soft shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-send me-1"></i> Result</div>
            <div class="card-body">
                {{ form_start(resultForm, {'action': path('app_cabinet_result', {'id': task.id})}) }}
                    {{ form_row(resultForm.message) }}

                    <div class="mb-3">
                        {{ form_label(resultForm.files) }}
                        {{ form_widget(resultForm.files) }}
                        <div class="form-text">You can attach several files. 25 MiB each, 10 files max.</div>
                        {{ form_errors(resultForm.files) }}
                    </div>

                    {% if result and result.files|length > 0 %}
                        <div class="mb-3">
                            <div class="fw-semibold small mb-2"><i class="bi bi-paperclip me-1"></i> Uploaded files</div>
                            <div class="list-group list-group-flush">
                                {% for file in result.files %}
                                    <div class="list-group-item d-flex align-items-center gap-2 py-2">
                                        <a class="small text-decoration-none flex-grow-1 d-inline-flex align-items-center gap-2 text-truncate"
                                           href="{{ path('app_cabinet_file_download', {'id': file.id}) }}">
                                            <i class="bi bi-file-earmark"></i>
                                            <span class="text-truncate">{{ file.originalName }}</span>
                                        </a>
                                        <span class="text-secondary small flex-shrink-0">{{ file.size }} B</span>
                                        {# Removes the file immediately, after the shared confirmation modal. #}
                                        <button type="button"
                                                class="btn btn-icon btn-outline-danger flex-shrink-0"
                                                data-bs-toggle="modal"
                                                data-bs-target="#removeFileModal"
                                                data-file-remove-url="{{ path('app_cabinet_remove_file', {'id': task.id, 'fileId': file.id}) }}"
                                                data-file-remove-token="{{ csrf_token('cabinet_remove_file_' ~ file.id) }}"
                                                data-file-remove-name="{{ file.originalName|e('html_attr') }}"
                                                aria-label="Remove {{ file.originalName }}">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" type="submit" name="save_result">
                            <i class="bi bi-save me-1"></i> Save result
                        </button>
                        <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#completeModal">
                            <i class="bi bi-check2-circle me-1"></i> Complete task
                        </button>
                    </div>

                    {# Inside the form on purpose: "Complete" submits this result. #}
                    {% include 'cabinet/_confirm_modal.html.twig' %}
                {{ form_end(resultForm) }}

                {# Removal posts its own form, so it must live outside the result form. #}
                {% include 'cabinet/_confirm_remove_file_modal.html.twig' %}

                <hr class="my-4">
                <form method="post" action="{{ path('app_cabinet_release', {'id': task.id}) }}" class="text-center"
                      onsubmit="return confirm('Return this task to the pool? The saved result draft will be removed.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('cabinet_release_' ~ task.id) }}">
                    <button class="btn btn-link btn-sm text-secondary" type="submit">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Return the task to the pool
                    </button>
                </form>
            </div>
        </div>
    {% elseif result %}
        <div class="card border-soft shadow-sm mt-4">
            <div class="card-header bg-white fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-check text-success"></i> Submitted result
                <span class="ms-auto small text-secondary">{{ result.submittedAt|date('d.m.Y H:i') }}</span>
            </div>
            <div class="card-body">
                <p class="mb-3">{{ result.message }}</p>
                {% if result.files|length > 0 %}
                    <div class="list-group list-group-flush">
                        {% for file in result.files %}
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 small"
                               href="{{ path('app_cabinet_file_download', {'id': file.id}) }}">
                                <i class="bi bi-paperclip"></i> {{ file.originalName }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}