{#
    Bootstrap confirmation modal for the (irreversible) manual completion.

    It must be rendered *inside* the result form: the "Complete" button submits
    that very form, so the message the worker typed is saved together with the
    completion instead of being silently discarded (ui-spec.md §12).
#}
<div class="modal fade" id="completeModal" tabindex="-1" aria-labelledby="completeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <i class="bi bi-exclamation-triangle-fill text-warning display-5"></i>
                <h5 class="fw-bold mt-2" id="completeModalLabel">Complete the task?</h5>
                <p class="text-secondary small mb-0">
                    The current result is saved and the task gets the status
                    <code>processed</code>. This action is <strong>irreversible</strong>:
                    the result can no longer be edited.
                </p>
            </div>
            <div class="modal-footer d-flex gap-2">
                <button type="button" class="btn btn-light flex-grow-1" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success flex-grow-1" name="save_and_complete" value="1">
                    <i class="bi bi-check2-circle me-1"></i> Complete
                </button>
            </div>
        </div>
    </div>
</div>
