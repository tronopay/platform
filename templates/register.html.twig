{% extends 'base.html.twig' %}

{% block title %}Register · Tronopay{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            <div class="card border-soft shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-person-plus fs-3 text-primary"></i>
                        <h1 class="h4 fw-bold mb-0">Create account</h1>
                    </div>
                    <p class="text-secondary small mb-4">
                        Simple registration with your Tron wallet address and a password.
                    </p>

                    {{ form_start(form) }}
                        {{ form_row(form.tronAddress) }}
                        {{ form_row(form.plainPassword) }}
                        <button class="btn btn-primary w-100 mt-2" type="submit" id="register_submit">
                            <i class="bi bi-check2 me-1"></i> Register
                        </button>
                    {{ form_end(form) }}

                    <p class="text-center small text-secondary mt-4 mb-0">
                        Already registered? <a href="{{ path('app_worker_login') }}">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}